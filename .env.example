# ── Base de datos (Supabase) ────────────────────────────────────
# Las dos apuntan al pooler, en modo SESIÓN, puerto 5432. La usa tanto la
# aplicación como las migraciones.
#
# No uses el modo transacción (puerto 6543): el pooler puede cambiar el
# backend de Postgres entre una consulta y la siguiente, y esta app manda
# varias consultas en paralelo por request (tRPC batching). Con eso, el modo
# transacción deja la conexión colgada para siempre, sin error ni timeout —
# las pantallas se quedan cargando sin mostrar nada.
#
# Están en Supabase → Project Settings → Database → Connection pooling.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ── Sesiones ────────────────────────────────────────────────────
# Con este secreto se firman las cookies del panel y del portal. Si es débil o
# se filtra, se pueden falsificar sesiones. Generá el tuyo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=cambiame-por-un-secreto-largo-y-aleatorio

# ── Mantenimiento automático ────────────────────────────────────
# Protege el endpoint que corre el cron diario (vencimientos e intereses).
CRON_SECRET=otro-secreto-aleatorio

# ── OAuth de Kimi (opcional) ────────────────────────────────────
# Sólo si se usa el botón "Sign in with Kimi". El login local con usuario y
# contraseña funciona sin esto.
APP_ID=club-local
KIMI_AUTH_URL=http://localhost:3000
KIMI_OPEN_URL=http://localhost:3000
OWNER_UNION_ID=

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────
# Sin WHATSAPP_ACCESS_TOKEN el webhook recibe los mensajes pero no puede
# responder. El número de prueba de la app (modo desarrollo) alcanza para
# probar con hasta 5 destinatarios verificados; el token de la página
# "API Setup" vence a las 24 h: para uno permanente, crear un usuario de
# sistema en business.facebook.com/settings con permisos
# whatsapp_business_messaging y whatsapp_business_management.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=club_panel_secreto_2026
# App Secret de la app de Meta: con esto se verifica la firma del webhook
# y nadie puede hacerse pasar por un socio. Recomendado en producción.
# WHATSAPP_APP_SECRET=

# ── IA (Groq) ───────────────────────────────────────────────────
# Clave de Groq (gratis, sin tarjeta): https://console.groq.com
# El modelo default es qwen/qwen3.8-27b: los gpt-oss-* gastan la mitad del
# presupuesto de tokens en razonamiento y las respuestas salen cortadas.
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# ── Frontend (se expone al navegador vía Vite) ──────────────────
VITE_KIMI_AUTH_URL=http://localhost:3000
VITE_APP_ID=club-local
